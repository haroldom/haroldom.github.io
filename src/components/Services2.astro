        class="services-arrow inline-flex items-center justify-center size-11 rounded-full border border-dark/20 text-dark transition-opacity duration-300 disabled:opacity-25">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
        </svg>
    </button>

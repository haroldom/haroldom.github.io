---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<header class="hero" id="top">
  <!-- top bar -->
  <div class="hero__bar container">
    <a class="hero__logo" href="#top" data-hero="fade" aria-label="Harold Ormeño">
      <img src="/images/logo.webp" alt="" width="364" height="365" />
    </a>
    <div class="hero__bar-actions">
      <a class="btn-pill btn-pill--solid" href="#contact" data-hero="fade" data-magnetic="0.3">
        {t('nav.bookCall')}
        <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path d="M1.5 10.5 10.5 1.5M4 1.5h6.5V8" stroke="currentColor" stroke-width="1.5"></path>
        </svg>
      </a>
      <a class="btn-pill btn-pill--outline" href="/cv.pdf" download data-hero="fade" data-magnetic="0.3">
        {t('nav.cv')}
      </a>
    </div>
  </div>

  <!-- taglines + portrait -->
  <div class="hero__stage container">
    <p class="hero__tagline small muted" data-hero="fade">
      {t('hero.tagline.1')}<br />{t('hero.tagline.2')}
    </p>

    <p class="hero__role muted" data-hero="fade">
      <span class="hero__role-icon">
        <svg width="18" height="18" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path fill-rule="evenodd" clip-rule="evenodd" d="M0 2.5C0 1.67157 0.671573 1 1.5 1H13.5C14.3284 1 15 1.67157 15 2.5V12.5C15 13.3284 14.3284 14 13.5 14H1.5C0.671573 14 0 13.3284 0 12.5V2.5ZM5.79293 7.50001L3.14648 4.85356L3.85359 4.14645L7.20714 7.50001L3.85359 10.8536L3.14648 10.1465L5.79293 7.50001ZM12 11H8V10H12V11Z" fill="#f2f0ec"></path> </g></svg>
      </span>
      <span class="hero__role-title">{t('hero.role.2')}</span>
      <span class="hero__role-tag">{t('hero.role.1')}</span>
    </p>
  </div>

  <div class="hero__portrait ph-media" data-hero="portrait">
    <img src="/images/profile.webp" alt="Portrait of Harold Ormeño" width="1023" height="1537" />
  </div>

  <!-- giant name — infinite horizontal marquee -->
  <h1 class="hero__name-mask" aria-label="Harold Ormeño">
    <span class="hero__name-inner" data-hero="name" aria-hidden="true">
      <span class="hero__marquee">
        <span class="hero__name serif">Harold&nbsp;Orme&ntilde;o</span>
        <span class="hero__name serif">Harold&nbsp;Orme&ntilde;o</span>
        <span class="hero__name serif">Harold&nbsp;Orme&ntilde;o</span>
        <span class="hero__name serif">Harold&nbsp;Orme&ntilde;o</span>
      </span>
    </span>
  </h1>

  <!-- bottom row -->
  <div class="hero__bottom container">
    <div class="hero__cta" data-hero="fade">
      <p class="hero__avail label muted">
        <span class="hero__avail-dot" aria-hidden="true"></span>
        {t('hero.available')}
      </p>
      <div class="hero__cta-row">
        <p class="hero__cta-text">{t('hero.cta')}</p>
        <a class="hero__cta-btn" href="#contact" aria-label={t('nav.bookCall')} data-magnetic>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M2 8h11M9 3.5 13.5 8 9 12.5" stroke="currentColor" stroke-width="1.4"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- loose element straddling the hero / next-section boundary -->
  <div class="hero__badge" data-hero="fade" aria-hidden="true">
      <svg viewBox="0 0 160 160" width="160" height="160" fill="none">
        <circle cx="80" cy="80" r="78.5" stroke="currentColor" stroke-width="1"></circle>
        <circle cx="80" cy="80" r="47" stroke="currentColor" stroke-width="1"></circle>
        <g class="hero__badge-spin">
          <defs>
            <path
              id="badge-circle"
              d="M80,80 m-62,0 a62,62 0 1,1 124,0 a62,62 0 1,1 -124,0"></path>
          </defs>
          <text class="hero__badge-text">
            <textPath href="#badge-circle" textLength="386">
              {`${t('hero.scroll')}   ${t('hero.scroll')}   ${t('hero.scroll')}  `}
            </textPath>
          </text>
        </g>
      </svg>
      <svg class="hero__badge-arrow" width="26" height="30" viewBox="0 0 26 30" fill="none">
        <path d="M13 1v26M2.5 17.5 13 28l10.5-10.5" stroke="currentColor" stroke-width="1.4"></path>
      </svg>
    </div>
</header>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    /* visible: the portrait and the scroll badge intentionally
       bleed past the hero's bottom edge into the next section */
    overflow: visible;
  }

  /* --- top bar --- */
  .hero__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: 1.4rem;
    position: relative;
    z-index: 4;
  }

  .hero__bar-actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .hero__logo img {
    width: 40px;
    height: 40px;
    object-fit: contain;
  }

  /* --- stage: taglines --- */
  .hero__stage {
    flex: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: start;
    gap: var(--gutter);
    padding-top: 2.5rem;
    position: relative;
    z-index: 1;
  }

  .hero__tagline {
    max-width: 24ch;
  }

  .hero__tagline::after {
    content: '';
    display: block;
    width: 2rem;
    height: 1px;
    background: var(--c-grey);
    margin-top: 1.1rem;
  }

  .hero__role {
    justify-self: end;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .hero__role-icon {
    margin-bottom: 0.15rem;
  }

  .hero__role-title {
    font-size: clamp(0.75rem, 1vw, 0.85rem);
    line-height: 1.3;
    opacity: 0.7;
  }

  .hero__role-tag {
    font-size: clamp(0.95rem, 1.3vw, 1.1rem);
    font-weight: 500;
    line-height: 1;
  }

  /* portrait: slim column, vertically centered in the viewport, b&w */
  .hero__portrait {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    width: clamp(250px, 23vw, 360px);
    height: min(78svh, 700px);
    z-index: 1;
    filter: grayscale(1) contrast(1.05);
  }

  /* --- giant name: infinite horizontal marquee --- */
  .hero__name-mask {
    position: absolute;
    top: 42%;
    left: 0;
    width: 100%;
    overflow: clip;
    z-index: 2;
    pointer-events: none;
    display: block;
    margin: 0;
    font-weight: 400;
  }

  .hero__name-inner {
    display: block;
    will-change: transform;
  }

  .hero__marquee {
    display: flex;
    width: max-content;
    animation: hero-marquee 26s linear infinite;
    will-change: transform;
  }

  .hero__name {
    display: block;
    font-size: var(--fs-hero);
    font-weight: 400;
    line-height: 0.94;
    letter-spacing: -0.015em;
    white-space: nowrap;
    text-transform: uppercase;
    padding-right: 0.14em; /* seam gap between repeats */
  }

  /* -50% == two of the four identical copies → seamless wrap */
  @keyframes hero-marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  /* --- bottom row --- */
  .hero__bottom {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--gutter);
    padding-bottom: 2rem;
    position: relative;
    z-index: 4;
  }

  .hero__avail {
    display: inline-flex;
    align-items: center;
    gap: 0.7em;
    margin-bottom: 0.9rem;
  }

  .hero__avail-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--c-white);
    box-shadow: 0 0 0 4px rgba(242, 240, 236, 0.14);
    animation: avail-pulse 2.4s ease-in-out infinite;
  }

  @keyframes avail-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 3px rgba(242, 240, 236, 0.1);
    }
    50% {
      box-shadow: 0 0 0 6px rgba(242, 240, 236, 0.22);
    }
  }

  .hero__cta-row {
    display: flex;
    align-items: center;
    gap: 1.4rem;
  }

  .hero__cta-text {
    font-size: 1.05rem;
    line-height: 1.4;
    max-width: 16ch;
  }

  .hero__cta-btn {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 1px solid var(--c-line-dark);
    border-radius: 50%;
    color: var(--c-white);
    transition: background-color 0.4s ease, color 0.4s ease, transform 0.5s var(--ease-out-expo);
  }

  .hero__cta-btn:hover {
    background: var(--c-white);
    color: var(--c-black);
    transform: scale(1.06);
  }

  /* --- scroll badge: loose element straddling the section boundary --- */
  .hero__badge {
    position: absolute;
    right: var(--gutter);
    bottom: 0;
    translate: 0 50%;
    z-index: 6;
    width: 160px;
    height: 160px;
    display: grid;
    place-items: center;
    color: var(--c-white);
  }

  .hero__badge > svg:first-child {
    position: absolute;
    inset: 0;
  }

  .hero__badge-spin {
    transform-origin: 80px 80px;
    animation: badge-spin 16s linear infinite;
  }

  .hero__badge-text {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    fill: var(--c-white);
    font-family: var(--f-sans);
  }

  .hero__badge-arrow {
    position: relative;
    color: var(--c-white);
  }

  @keyframes badge-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (max-width: 720px) {
    .hero__stage {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      gap: 1.5rem;
    }
    .hero__role {
      justify-self: center;
    }
    .hero__portrait {
      width: 62vw;
      height: 52svh;
    }
    .hero__name-mask {
      top: auto;
      bottom: 26%;
    }
    .hero__bottom {
      justify-content: center;
      padding-bottom: 5.5rem; /* room for the fixed nav */
    }
    .hero__badge {
      display: none;
    }
  }
</style>

<style is:global>
  /* animation pre-states (JS-gated; global because they cross component scopes) */
  html.js .hero [data-hero='fade'],
  html.js .navpill {
    opacity: 0;
  }

  html.js .hero__name-inner {
    transform: translateY(110%);
  }

  html.js .hero__portrait {
    clip-path: inset(100% 0 0 0);
  }

  @media (prefers-reduced-motion: reduce) {
    html.js .hero [data-hero='fade'],
    html.js .navpill {
      opacity: 1;
    }
    html.js .hero__name-inner {
      transform: none;
    }
    .hero__marquee {
      animation: none !important;
    }
    html.js .hero__portrait {
      clip-path: none;
    }
    .hero__badge-spin,
    .hero__avail-dot {
      animation: none !important;
    }
  }
</style>

<script>
  import { gsap, onReady, reducedMotion } from '../scripts/app';

  onReady(() => {
    if (reducedMotion) return;

    const hero = document.querySelector<HTMLElement>('.hero');
    if (!hero) return;

    /* intro timeline */
    const tl = gsap.timeline({ defaults: { ease: 'expo.out' } });

    tl.to('.hero__name-inner', { y: 0, duration: 1.6 }, 0.2)
      .to(
        '.hero__portrait',
        { clipPath: 'inset(0% 0 0 0)', duration: 1.6, ease: 'expo.inOut' },
        0.1
      )
      .to(
        '.hero [data-hero="fade"]',
        { opacity: 1, duration: 1.2, stagger: 0.08 },
        0.9
      )
      .to('.navpill', { opacity: 1, duration: 1 }, 1.1);

    /* scroll parallax: name drifts down slower, portrait scales */
    gsap.to('.hero__name-mask', {
      yPercent: 35,
      ease: 'none',
      scrollTrigger: {
        trigger: hero,
        start: 'top top',
        end: 'bottom top',
        scrub: true,
      },
    });

    gsap.to('.hero__portrait img', {
      scale: 1.12,
      ease: 'none',
      scrollTrigger: {
        trigger: hero,
        start: 'top top',
        end: 'bottom top',
        scrub: true,
      },
    });
  });
</script>

---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="playground" id="playground">
  <canvas class="playground__canvas" aria-hidden="true"></canvas>

  <svg
    class="playground__squiggle"
    viewBox="0 0 1440 500"
    fill="none"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <g class="playground__squiggle-g">
      <path
        class="playground__squiggle-path"
        d="M-160 480 C 200 400, 320 470, 470 445 C 640 415, 700 470, 830 460 C 940 452, 980 380, 940 350 C 905 328, 860 390, 930 415 C 990 436, 1040 380, 1064 310"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        vector-effect="non-scaling-stroke"></path>
    </g>
  </svg>

  <span class="playground__dot" aria-hidden="true"></span>

  <div class="playground__content container">
    <p class="playground__line" data-split="lines">
      <em class="serif-italic">{t('playground.years')}</em> {t('playground.line')}<span
        class="playground__line-end"
        aria-hidden="true"></span>
    </p>
  </div>
</section>

<style>
  .playground {
    position: relative;
    min-height: 130svh;
    display: grid;
    place-items: center;
    background: var(--c-black);
    overflow: clip;
  }

  .playground__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .playground__squiggle {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--c-white);
    pointer-events: none;
    opacity: 0.9;
  }

  .playground__dot {
    position: absolute;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--c-white);
    z-index: 2;
    pointer-events: none;
  }

  .playground__line-end {
    display: inline-block;
    width: 0;
    height: 1em;
    vertical-align: baseline;
  }

  .playground__content {
    position: relative;
    z-index: 2;
    pointer-events: none;
  }

  .playground__line {
    max-width: 26ch;
    margin-inline: auto;
    text-align: center;
    font-size: var(--fs-statement);
    line-height: 1.3;
    font-weight: 450;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .playground__line em {
    font-weight: 300;
  }
</style>

<script>
  import { onReady, gsap, ScrollTrigger, reducedMotion } from '../scripts/app';

  onReady(async () => {
    const section = document.querySelector<HTMLElement>('.playground');
    const canvas = document.querySelector<HTMLCanvasElement>('.playground__canvas');
    if (!section || !canvas) return;

    /* anchor the squiggle's end (and its dot) to the actual end of the
       sentence, measured from an inline marker after the final period */
    const svg = document.querySelector<SVGSVGElement>('.playground__squiggle');
    const path = document.querySelector<SVGPathElement>('.playground__squiggle-path');
    const squiggleGroup = document.querySelector<SVGGElement>('.playground__squiggle-g');
    const dot = document.querySelector<HTMLElement>('.playground__dot');
    const marker = document.querySelector<HTMLElement>('.playground__line-end');

    // the path's untranslated endpoint in viewBox coordinates
    const END_X = 1064;
    const END_Y = 310;

    function placeSquiggle() {
      if (!svg || !squiggleGroup || !dot || !marker) return;
      const s = section!.getBoundingClientRect();
      const m = marker.getBoundingClientRect();

      // uniform px→viewBox scale: viewBox height follows the section's
      // aspect ratio so the curve is never stretched
      const k = 1440 / s.width;
      svg.setAttribute('viewBox', `0 0 1440 ${(s.height * k).toFixed(1)}`);

      // dot in px: just right of the period, above the baseline
      const dotX = m.left - s.left + 14;
      const dotY = m.top - s.top - 4;
      dot.style.left = `${dotX - 4.5}px`;
      dot.style.top = `${dotY - 4.5}px`;

      // translate the whole path so its end lands on the dot
      squiggleGroup.setAttribute(
        'transform',
        `translate(${(dotX * k - END_X).toFixed(1)} ${(dotY * k - END_Y).toFixed(1)})`
      );
    }

    placeSquiggle();
    window.addEventListener('resize', placeSquiggle);

    /* draw the squiggle while scrolling — starting from its end point
       (the dot next to the text), flowing backwards along the path */
    if (path && !reducedMotion) {
      const len = path.getTotalLength();
      gsap.set(path, { strokeDasharray: len, strokeDashoffset: -len });
      if (dot) gsap.set(dot, { opacity: 0 });

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: 'top 75%',
          end: 'center 40%',
          scrub: 0.8,
        },
      });
      if (dot) tl.to(dot, { opacity: 1, duration: 0.05, ease: 'none' }, 0);
      tl.to(path, { strokeDashoffset: 0, duration: 1, ease: 'none' }, 0);
    }

    /* three.js scene, code-split so the home payload stays lean */
    const { initPlayground } = await import('../scripts/playground');
    initPlayground(canvas, section);
    ScrollTrigger.refresh();
  });
</script>

---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const navLinks = [
  { key: 'footer.about', href: '#about', newPage: false },
  { key: 'footer.work', href: '#projects', newPage: false },
  { key: 'footer.process', href: '#process', newPage: false },
  { key: 'footer.services', href: '#services', newPage: false },
  { key: 'footer.contact', href:"https://api.whatsapp.com/send?phone=51942466345&text=Hola Harold 👋.", newPage: true},
] as const;

// REPLACE: real social links
const socials = [
  // { name: 'YouTube', href: 'https://youtube.com/@' },
  { name: 'LinkedIn', href: 'https://linkedin.com/in/haroldom' },
  { name: 'Instagram', href: 'https://instagram.com/sebaasom' },
  { name: 'GitHub', href: 'https://github.com/haroldom' }
];
---

<footer class="footer" id="contact">
  <div class="container footer__grid">
    <!-- brand -->
    <div class="footer__brand">
      <a class="footer__logo" href="#top" aria-label="Harold Ormeño">
        <img src="/images/logo.webp" alt="" width="364" height="365" />
      </a>
      <p class="small muted footer__blurb">{t('footer.blurb')}</p>
      <span class="footer__blurb-dash" aria-hidden="true"></span>
    </div>

    <!-- navigation -->
    <nav class="footer__nav" aria-label="Footer">
      <p class="label muted">{t('footer.navigation')}</p>
      <ul>
        {
          navLinks.map((link) => (
            <li>
              <a class="footer__nav-link" href={link.href} target={link.newPage ? "_blank" : undefined} rel={link.newPage ? "noopener noreferrer" : undefined}>
                <span class="serif">{t(link.key)}</span>
                <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3 13 13 3M5.5 3H13v7.5" stroke="currentColor" stroke-width="1.3"></path>
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- studio details -->
    <div class="footer__col">
      <p class="label muted">{t('footer.studio')}</p>
      <ul class="footer__studio">
        <li>
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="2.5" y="5" width="19" height="14" rx="2" stroke="currentColor" stroke-width="1.4"></rect>
            <path d="m3.5 6.5 8.5 6.5 8.5-6.5" stroke="currentColor" stroke-width="1.4"></path>
          </svg>
          <a class="footer__mail" href="mailto:h4roldsmail@gmail.com">h4roldsmail@gmail.com</a>
        </li>
        <li>
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.4"></circle>
            <path
              d="M3 12h18M12 3c2.5 2.4 3.9 5.5 3.9 9s-1.4 6.6-3.9 9c-2.5-2.4-3.9-5.5-3.9-9S9.5 5.4 12 3Z"
              stroke="currentColor"
              stroke-width="1.4"></path>
          </svg>
          <span class="small">
            {t('footer.based')}<br />{t('footer.working')}.
          </span>
        </li>
      </ul>
    </div>

    <!-- socials -->
    <div class="footer__col">
      <p class="label muted">{t('footer.socials')}</p>
      <ul class="footer__socials">
        {
          socials.map((s) => (
            <li>
              <a class="footer__social-link" href={s.href} target="_blank" rel="noopener noreferrer">
                {s.name}
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3 13 13 3M5.5 3H13v7.5" stroke="currentColor" stroke-width="1.3"></path>
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <!-- bottom bar -->
  <div class="container footer__bar">
    <div class="footer__time">
      <p class="label muted footer__time-label">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"></circle>
          <path d="M12 7v5l3.5 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
        </svg>
        {t('footer.localTime')}
      </p>
      <p class="footer__clock" data-clock>--:--:--</p>
      <p class="small muted" data-clock-date></p>
    </div>

    <div class="footer__legal">
      <p class="small muted">© {year} Harold Ormeño</p>
      <p class="small muted">{t('footer.rights')}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--c-black);
    padding-top: clamp(4rem, 9vh, 7rem);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.3fr 1.4fr 1fr 0.8fr;
    gap: calc(var(--gutter) * 1.4);
    padding-bottom: clamp(4rem, 9vh, 7rem);
  }

  /* --- brand --- */
  .footer__logo img {
    width: 52px;
    height: 52px;
    object-fit: contain;
  }

  .footer__blurb {
    margin-top: clamp(2rem, 22vh, 16rem);
    max-width: 22ch;
  }

  .footer__blurb-dash {
    display: block;
    width: 2rem;
    height: 1px;
    background: var(--c-grey);
    margin-top: 1.4rem;
  }

  /* --- navigation --- */
  .footer__nav ul {
    margin-top: 1.6rem;
  }

  .footer__nav-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-block: 1.05rem;
    border-bottom: 1px solid var(--c-line-dark);
    font-size: clamp(1.4rem, 1.9vw, 1.9rem);
    color: var(--c-white);
    transition: padding-left 0.5s var(--ease-out-expo), color 0.3s ease;
  }

  .footer__nav-link svg {
    color: var(--c-grey);
    transition: transform 0.4s var(--ease-out-expo), color 0.3s ease;
  }

  .footer__nav-link:hover {
    padding-left: 0.6rem;
    color: var(--c-accent);
  }

  .footer__nav-link:hover svg {
    transform: translate(3px, -3px);
    color: var(--c-accent);
  }

  /* --- studio --- */
  .footer__studio {
    margin-top: 1.6rem;
    display: grid;
    gap: 1.2rem;
  }

  .footer__studio li {
    display: flex;
    gap: 0.8rem;
    align-items: flex-start;
    color: var(--c-white);
  }

  .footer__studio svg {
    flex-shrink: 0;
    margin-top: 0.15em;
    color: var(--c-white);
  }

  .footer__mail {
    font-size: var(--fs-small);
    text-decoration: underline;
    text-underline-offset: 0.25em;
    transition: color 0.3s ease;
  }

  .footer__mail:hover {
    color: var(--c-accent);
  }

  /* --- socials --- */
  .footer__socials {
    margin-top: 1.6rem;
    display: grid;
    gap: 1.1rem;
  }

  .footer__social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-size: 1.15rem;
    color: var(--c-white);
    transition: color 0.3s ease;
  }

  .footer__social-link svg {
    color: var(--c-grey);
    transition: transform 0.4s var(--ease-out-expo);
  }

  .footer__social-link:hover {
    color: var(--c-accent);
  }

  .footer__social-link:hover svg {
    transform: translate(3px, -3px);
  }

  /* --- bottom bar --- */
  .footer__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--gutter);
    border-top: 1px solid var(--c-line-dark);
    padding-block: 2rem;
  }

  .footer__time-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
  }

  .footer__clock {
    font-size: clamp(1.8rem, 2.4vw, 2.4rem);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    margin-block: 0.2rem;
  }

  .footer__top {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }

  .footer__top-btn {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border: 1px solid var(--c-line-dark);
    border-radius: 50%;
    color: var(--c-white);
    transition: background-color 0.4s ease, color 0.4s ease, transform 0.5s var(--ease-out-expo);
  }

  .footer__top-btn:hover {
    background: var(--c-white);
    color: var(--c-black);
    transform: scale(1.06);
  }

  .footer__top-label {
    font-size: var(--fs-small);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .footer__legal {
    text-align: right;
  }

  @media (max-width: 900px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer__blurb {
      margin-top: 1.4rem;
    }
    .footer__bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 2rem;
      padding-bottom: 6rem; /* room for the fixed nav */
    }
    .footer__legal {
      text-align: left;
    }
  }
</style>

<script>
  import { onReady, getLenis } from '../scripts/app';

  onReady(() => {
    /* live clock — Peru local time (GMT-5) */
    const clock = document.querySelector<HTMLElement>('[data-clock]');
    const dateEl = document.querySelector<HTMLElement>('[data-clock-date]');
    const lang = document.documentElement.lang || 'en';

    const timeFmt = new Intl.DateTimeFormat(lang, {
      timeZone: 'America/Lima',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: true,
    });
    const dateFmt = new Intl.DateTimeFormat(lang, {
      timeZone: 'America/Lima',
      weekday: 'long',
      month: 'short',
      day: 'numeric',
      year: 'numeric',
      timeZoneName: 'shortOffset',
    });

    function tick() {
      const now = new Date();
      if (clock) clock.textContent = timeFmt.format(now);
      if (dateEl) dateEl.textContent = dateFmt.format(now);
    }
    tick();
    setInterval(tick, 1000);

  });
</script>

const videos = [
  '/videos/discover.mp4',
  '/videos/design.mp4',
  '/videos/develop.mp4',
  '/videos/deliver.mp4',
];

const steps = [1, 2, 3, 4].map((n, i) => ({
  num: `0${n}`,
  title: t(`process.0${n}.title` as Parameters<typeof t>[0]),
  desc: t(`process.0${n}.desc` as Parameters<typeof t>[0]),
  tags: tags[lang][i],
  icon: icons[i],
  video: videos[i],
}));
---

<section class="process theme-light section" id="process">
  <div class="container">
    <!-- header: editorial, full width, staggered lines -->
    <div class="process__head">
      <h2 class="process__heading serif">
        <span class="process__heading-line process__heading-l1" data-split="lines">
          {t('process.heading.1')}
        </span>
        <em class="serif-italic process__heading-line process__heading-l2" data-split="lines">
          {t('process.heading.2')}
        </em>
      </h2>

      <div class="process__head-row">
        <p class="process__intro" data-split="words">{t('process.intro')}</p>
        <a class="btn-pill btn-pill--dark process__cta" href="https://cal.com/haroldom" target="_blank" data-magnetic="0.25">
          {t('process.cta')}
          <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M1.5 10.5 10.5 1.5M4 1.5h6.5V8" stroke="currentColor" stroke-width="1.5"
            ></path>
          </svg>
        </a>
      </div>
    </div>

    <!-- stacking step cards -->
    <ol class="process__steps">
      {
        steps.map((step, i) => (
          <li class="process__step" style={`--i: ${i}`}>
            <div class="process__step-inner">
              <span class="process__num serif" aria-hidden="true">
                {step.num}
              </span>

              <div class="process__body">
                <span class="process__icon" aria-hidden="true">
                  <svg
                    width={step.icon.width}
                    height={step.icon.height}
                    viewBox={step.icon.viewBox}
                    fill="none"
                  >
                    {step.icon.paths.map((d) => (
                      <path
                        d={d}
                        stroke="currentColor"
                        stroke-width={step.icon.strokeWidth}
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    ))}
                  </svg>
                </span>
                <h3 class="process__title">{step.title}</h3>
                <p class="small muted process__desc">{step.desc}</p>
                <ul class="process__tags">
                  {step.tags.map((tag) => (
                    <li class="process__tag small">{tag}</li>
                  ))}
                </ul>
              </div>

              <div class="process__media ph-media" data-parallax>
                <video src={step.video} autoplay muted loop playsinline preload="metadata"
                ></video>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process {
    /* stacked cards need room to scroll */
    padding-bottom: clamp(4rem, 10vh, 8rem);
  }

  /* --- header: editorial full-width --- */
  .process__head {
    margin-bottom: clamp(5rem, 12vh, 9rem);
  }

  .process__kicker {
    margin-bottom: 2rem;
  }

  .process__heading {
    font-size: clamp(3.2rem, 9vw, 8.5rem);
    line-height: 1;
    letter-spacing: -0.015em;
    font-weight: 400;
  }

  .process__heading-line {
    display: block;
  }

  .process__heading-l2 {
    font-weight: 300;
    margin-left: clamp(3rem, 24vw, 24rem);
  }

  .process__head-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--gutter);
    margin-top: clamp(2.5rem, 6vh, 4rem);
  }

  .process__intro {
    max-width: 36ch;
    font-size: 1.05rem;
    line-height: 1.5;
  }

  .process__cta {
    flex-shrink: 0;
  }

  /* --- stacking cards --- */
  .process__steps {
    display: grid;
  }

  .process__step {
    position: sticky;
    top: calc(4.5rem + var(--i) * 1.5rem);
  }

  .process__step-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1fr minmax(280px, 42%);
    column-gap: var(--gutter);
    align-items: stretch;
    background: var(--c-paper);
    border-top: 1px solid var(--c-line-light);
    min-height: 52vh;
    overflow: clip;
  }

  /* huge ghost numeral sitting behind the content */
  .process__num {
    position: absolute;
    left: -0.04em;
    top: 50%;
    transform: translateY(-50%);
    font-size: clamp(14rem, 26vw, 26rem);
    line-height: 0.8;
    color: rgba(12, 12, 12, 0.05);
    pointer-events: none;
    z-index: 0;
    user-select: none;
  }

  .process__body {
    position: relative;
    z-index: 1;
    padding-left: clamp(5rem, 11vw, 11rem);
    padding-block: 2.2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .process__icon {
    display: inline-block;
    margin-bottom: 1.2rem;
    color: var(--c-black);
  }

  .process__title {
    font-size: clamp(2rem, 3.2vw, 3rem);
    font-weight: 550;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-bottom: 0.7rem;
  }

  .process__desc {
    font-size: 1rem;
    line-height: 1.55;
    max-width: 42ch;
  }

  .process__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.6rem;
  }

  .process__tag {
    padding: 0.45em 1.1em;
    border: 1px solid rgba(12, 12, 12, 0.18);
    border-radius: 100px;
    color: var(--c-black);
    background: #fff;
  }

  @media (max-width: 900px) {
    .process__heading-l2 {
      margin-left: 2rem;
    }
    .process__head-row {
      flex-direction: column;
      align-items: flex-start;
    }
    .process__steps {
      gap: 3rem;
    }
    .process__step {
      position: static;
    }
    .process__step-inner {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .process__num {
      font-size: 9rem;
      top: 0;
      transform: none;
      padding-top: 0.15em;
    }
    .process__body {
      padding-left: 3.5rem;
    }
  }
</style>

<script>
  import { onReady, gsap, reducedMotion } from '../scripts/app';

  onReady(() => {
    if (reducedMotion) return;

    // the two heading lines drift apart horizontally while scrolling
    const head = document.querySelector<HTMLElement>('.process__head');
    if (!head) return;

    gsap.to('.process__heading-l1', {
      xPercent: 4,
      ease: 'none',
      scrollTrigger: { trigger: head, start: 'top bottom', end: 'bottom top', scrub: true },
    });
    gsap.to('.process__heading-l2', {
      xPercent: -5,
      ease: 'none',
      scrollTrigger: { trigger: head, start: 'top bottom', end: 'bottom top', scrub: true },
    });
  });
</script>

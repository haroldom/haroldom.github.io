---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const tags: Record<Lang, string[][]> = {
  en: [
    ['Research', 'Strategy', 'Insight'],
    ['UX', 'UI', 'Design system'],
    ['Frontend', 'Performance', 'Quality'],
    ['Testing', 'Deployment', 'Optimization'],
  ],
  es: [
    ['Investigación', 'Estrategia', 'Insight'],
    ['UX', 'UI', 'Sistema de diseño'],
    ['Frontend', 'Rendimiento', 'Calidad'],
    ['Testing', 'Despliegue', 'Optimización'],
  ],
};

interface StepIcon {
  viewBox: string;
  width: number;
  height: number;
  strokeWidth: number;
  paths: string[];
}

const icons: StepIcon[] = [

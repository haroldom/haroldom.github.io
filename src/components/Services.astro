---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const previews = ['/images/graphicdesign.webp', '/images/project2.webp', '/images/project3.webp', '/images/project4.webp', '/images/project5.webp'];
const videoSrcs = ['', '/videos/services-video.mp4', '/videos/services-webdesign.mp4', '/videos/services-webdev.mp4', '/videos/services-3d.mp4'];

const services = [1, 2, 3, 4, 5].map((n, i) => ({
  num: `0${n}`,
  title: t(`services.0${n}.title` as Parameters<typeof t>[0]),
  desc: t(`services.0${n}.desc` as Parameters<typeof t>[0]),
  img: previews[i],
  video: videoSrcs[i],
}));

// REPLACE: real testimonials
const testimonials = [
  { quote: t('services.testimonial.01'), name: 'Gustavo Marquez', role: 'Co-founder, Collie Valley', image: '/images/testimonials/gustavo.webp' },
  { quote: t('services.testimonial.02'), name: 'Luis Uculmana', role: 'Software Engineer', image: '/images/testimonials/luis.webp' },
  { quote: t('services.testimonial.03'), name: 'Johanna Barrientos', role: 'Com. Mgr, Orange Logistic', image: '/images/testimonials/johanna-barrientos.webp' },
  { quote: t('services.testimonial.04'), name: 'Gina Alarcón', role: 'Ops. Mgr, Orange Logistic', image: '/images/testimonials/gina-alarcon.webp' },
];
---

<section class="services section" id="services">
  <div class="container services__grid">
    <!-- testimonials rail: infinite vertical loop, faded top & bottom -->
    <aside class="services__rail" aria-label="Testimonials" data-reveal>
      <div class="services__loop">
        {
          [0, 1].map((dup) => (
            <div class="services__group" aria-hidden={dup === 1 ? 'true' : undefined}>
              {testimonials.map((item) => (
                <figure class="services__quote">
                  <svg width="24" height="18" viewBox="0 0 26 20" aria-hidden="true">
                    <path
                      d="M0 0h10v10c0 6-3 9-9 10l-1-3c3-1 4-2.5 4-5H0V0Zm15 0h10v10c0 6-3 9-9 10l-1-3c3-1 4-2.5 4-5h-4V0Z"
                      fill="currentColor"
                    />
                  </svg>
                  <blockquote class="services__quote-text">{item.quote}</blockquote>
                  <figcaption class="services__quote-by">
                    <img
                      class="services__avatar"
                      src={item.image}
                      alt=""
                      width="40"
                      height="40"
                      loading="lazy"
                    />
                    <span>
                      <span class="services__quote-name">{item.name}</span>
                      <span class="small muted">{item.role}</span>
                    </span>
                  </figcaption>
                </figure>
              ))}
            </div>
          ))
        }
      </div>
    </aside>

    <!-- heading + list -->
    <div class="services__main">
      <h2 class="services__heading serif">
        <span data-split="lines">{t('services.heading.1')}</span>
        <span data-split="lines">{t('services.heading.2')}</span>
        <span data-split="lines">{t('services.heading.3')}</span>
      </h2>

      <ol class="services__list">
        {
          services.map((s, i) => (
            <li class="services__item" data-reveal data-reveal-delay={i * 0.05} data-img={s.img} data-video={s.video || undefined}>
              <span class="services__num label muted">{s.num}</span>
              <div>
                <h3 class="services__title">{s.title}</h3>
                <p class="small muted">{s.desc}</p>
                {
                  s.video ? (
                    <video class="services__mobile-media" muted loop playsinline autoplay preload="auto" poster={s.img}>
                      <source src={s.video} type="video/mp4" />
                    </video>
                  ) : (
                    <img class="services__mobile-media" src={s.img} alt="" loading="lazy" />
                  )
                }
              </div>
            </li>
          ))
        }
      </ol>

      <div class="services__float">
        <video class="services__float-video" muted loop playsinline preload="auto"></video>
        <img class="services__float-img" src={services[0].img} alt="" />
      </div>
    </div>
  </div>
</section>

<style>
  .services {
    background: var(--c-black);
  }

  .services__grid {
    display: grid;
    grid-template-columns: minmax(220px, 1fr) 2.2fr;
    gap: calc(var(--gutter) * 2);
    align-items: start;
  }

  /* --- testimonials: infinite loop --- */
  .services__rail {
    position: sticky;
    top: 12vh;
    height: min(68vh, 620px);
    overflow: clip;
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent,
      #000 18%,
      #000 82%,
      transparent
    );
    mask-image: linear-gradient(to bottom, transparent, #000 18%, #000 82%, transparent);
  }

  .services__loop {
    animation: services-loop 26s linear infinite;
    will-change: transform;
  }

  .services__rail:hover .services__loop {
    animation-play-state: paused;
  }

  @keyframes services-loop {
    to {
      transform: translateY(-50%);
    }
  }

  .services__quote {
    display: grid;
    gap: 1.1rem;
    max-width: 32ch;
    padding-block: 2rem;
    border-top: 1px solid var(--c-line-dark);
    color: var(--c-white);
  }

  .services__quote-text {
    font-size: 1.05rem;
    line-height: 1.5;
    color: rgba(242, 240, 236, 0.85);
  }

  .services__quote-by {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .services__quote-by > span {
    display: grid;
    gap: 0.1rem;
  }

  .services__quote-name {
    font-size: 0.95rem;
    color: var(--c-white);
  }

  .services__avatar {
    object-fit: cover;
    border-radius: 50%;
  }

  @media (prefers-reduced-motion: reduce) {
    .services__loop {
      animation: none;
    }
    .services__rail {
      mask-image: none;
      -webkit-mask-image: none;
    }
  }

  /* --- heading --- */
  .services__heading {
    font-size: var(--fs-display);
    line-height: 0.98;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    font-weight: 400;
    margin-bottom: clamp(3rem, 8vh, 5.5rem);
  }

  .services__heading span {
    display: block;
  }

  /* staggered editorial offsets */
  .services__heading span:nth-child(2) {
    margin-left: clamp(2rem, 9vw, 9rem);
  }

  .services__heading span:nth-child(3) {
    margin-left: clamp(1rem, 4vw, 4rem);
  }

  /* --- list --- */
  .services__list {
    display: grid;
  }

  .services__item {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: 1rem;
    align-items: baseline;
    padding-block: 1.6rem;
    border-top: 1px solid var(--c-line-dark);
    transition: padding-left 0.5s var(--ease-out-expo);
  }

  .services__item:hover {
    padding-left: 0.8rem;
  }

  .services__num {
    transition: color 0.4s ease;
  }

  .services__item:hover .services__num {
    color: var(--c-accent);
  }

  .services__item:last-child {
    border-bottom: 1px solid var(--c-line-dark);
  }

  .services__title {
    font-size: clamp(1.2rem, 1.8vw, 1.6rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    margin-bottom: 0.3rem;
  }

  .services__float {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 99;
    pointer-events: none;
    opacity: 0;
    width: 220px;
    will-change: transform, opacity;
  }

  .services__float-img,
  .services__float-video {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 10px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
  }

  .services__mobile-media {
    display: none;
  }

  @media (max-width: 900px) {
    .services__grid {
      grid-template-columns: 1fr;
    }
    .services__rail {
      position: static;
      order: 2;
      display: flex;
      justify-content: center;
      height: auto;
      overflow: visible;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .services__loop {
      animation: none;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .services__group[aria-hidden="true"] {
      display: none;
    }
    .services__quote {
      text-align: center;
      max-width: 40ch;
    }
    .services__quote-by {
      justify-content: center;
    }
    .services__float,
    .services__float-img,
    .services__float-video {
      display: none;
    }
    .services__mobile-media {
      display: block;
      width: 100%;
      aspect-ratio: 16 / 10;
      object-fit: cover;
      border-radius: 8px;
      margin-top: 1rem;
    }
    .services__item {
      grid-template-columns: 3rem 1fr;
    }
    .services__item:hover {
      padding-left: 0;
    }
    .services__item:hover .services__num {
      color: inherit;
    }
  }
</style>

<script>
  import { onReady, gsap, reducedMotion } from '../scripts/app';

  onReady(() => {
    if (reducedMotion) return;

    // On mobile, skip hover/float logic — inline media + data-reveal handle it
    if (window.innerWidth < 900) return;

    // heading lines drift in alternating directions while scrolling
    const heading = document.querySelector<HTMLElement>('.services__heading');
    if (!heading) return;

    heading.querySelectorAll(':scope > span').forEach((line, i) => {
      gsap.to(line, {
        xPercent: i % 2 === 0 ? 3.5 : -3.5,
        ease: 'none',
        scrollTrigger: {
          trigger: heading,
          start: 'top bottom',
          end: 'bottom top',
          scrub: true,
        },
      });
    });

    // floating image/video follows cursor over service items
    const list = document.querySelector<HTMLElement>('.services__list');
    const float = document.querySelector<HTMLElement>('.services__float');
    const floatImg = float?.querySelector<HTMLImageElement>('.services__float-img');
    const floatVideo = float?.querySelector<HTMLVideoElement>('.services__float-video');
    const items = gsap.utils.toArray<HTMLElement>('.services__item');
    if (!list || !float || !floatImg || !floatVideo || !items.length) return;

    let mouseX = 0, mouseY = 0;
    let currentImg = '';
    let currentVideo = '';

    function onMove(e: MouseEvent) {
      mouseX = e.clientX;
      mouseY = e.clientY;

      gsap.to(float, {
        x: mouseX + 120,
        y: mouseY - 160,
        duration: 0.8,
        ease: 'power2.out',
        overwrite: 'auto',
      });
    }

    function onEnter(this: HTMLElement, e: MouseEvent) {
      const imgSrc = this.dataset.img;
      const videoSrc = this.dataset.video;
      if (!imgSrc) return;

      gsap.set(float, {
        x: e.clientX + 120,
        y: e.clientY - 160,
      });

      if (videoSrc) {
        floatImg!.style.display = 'none';
        floatVideo!.style.display = 'block';
        if (videoSrc !== currentVideo) {
          currentVideo = videoSrc;
          floatVideo!.src = videoSrc;
        }
        floatVideo!.currentTime = 0;
        floatVideo!.play().catch(() => {});
      } else {
        floatVideo!.style.display = 'none';
        floatVideo!.pause();
        floatImg!.style.display = 'block';
        if (imgSrc !== currentImg) {
          currentImg = imgSrc;
          floatImg!.src = imgSrc;
        }
      }

      gsap.to(float, {
        opacity: 1,
        scale: 1,
        duration: 0.4,
        ease: 'power2.out',
        overwrite: 'auto',
      });
    }

    function onLeave(this: HTMLElement) {
      gsap.to(float, {
        opacity: 0,
        scale: 0.9,
        duration: 0.3,
        ease: 'power2.out',
        overwrite: 'auto',
        onComplete: () => {
          floatVideo!.pause();
        },
      });
    }

    items.forEach((el) => {
      el.addEventListener('mouseenter', onEnter);
      el.addEventListener('mouseleave', onLeave);
    });

    list.addEventListener('pointermove', onMove);
  });
</script>

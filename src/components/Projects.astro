---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// REPLACE: real project links
const projects = [
  {
    title: 'Orange Logistics',
    meta: 'Modern Website & Design',
    href: '#',
    preview: '/images/project1.webp',
  },
  {
    title: 'Collie Valley',
    meta: 'Brand & Website',
    href: '#',
    preview: '/images/project2.webp',
  },
  {
    title: 'Nam',
    meta: 'E-commerce Experience',
    href: '#',
    preview: '/images/project3.webp',
  },
  {
    title: 'Treepilot',
    meta: 'Product Website',
    href: '#',
    preview: '/images/project4.webp',
  },
];
---

<section class="projects section" id="projects">
  <div class="container">
    <p class="label muted projects__label" data-reveal>{t('projects.label')}</p>

    <div class="projects__wrap">
      <ul class="projects__list">
        {
          projects.map((p, i) => (
            <li
              class:list={['projects__item', { 'is-active': i === 0 }]}
              data-index={i}
              data-preview={p.preview}
              data-tilt={i % 2 === 0 ? -7 : 7}
            >
              <a class="projects__link" href={p.href}>
                <svg class="projects__arrow" width="70" height="41" viewBox="0 0 70 41" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M46.6667 0C46.6667 2.16417 48.8046 5.39583 50.9687 8.10833C53.7512 11.6083 57.0762 14.6621 60.8883 16.9925C63.7467 18.7396 67.2117 20.4167 70 20.4167M70 20.4167C67.2117 20.4167 63.7437 22.0937 60.8883 23.8408C57.0762 26.1742 53.7512 29.2279 50.9687 32.7221C48.8046 35.4375 46.6667 38.675 46.6667 40.8333M70 20.4167H-1.90735e-06" stroke="white"/>
                </svg>

                <span class="projects__name serif">{p.title}</span>
              </a>
              <p class="projects__meta muted">{p.meta}</p>
            </li>
          ))
        }
      </ul>

      <!-- preview stays fixed at the vertical center while the list scrolls -->
      <div class="projects__stage" aria-hidden="true">
        <div class="projects__sticky">
          <div class="projects__card ph-media" data-parallax>
            <img src={projects[0].preview} alt="" width="1200" height="900" loading="lazy" />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .projects {
    background: var(--c-black);
  }

  .projects__label {
    margin-bottom: clamp(3rem, 7vh, 5rem);
  }

  .projects__wrap {
    display: grid;
    grid-template-columns: 1.1fr minmax(320px, 44%);
    gap: var(--gutter);
    align-items: start;
  }

  /* --- list --- */
  .projects__item {
    position: relative;
    padding-block: clamp(2rem, 6vh, 4rem);
  }

  .projects__link {
    display: block;
    position: relative;
  }

  .projects__arrow {
    position: absolute;
    left: 0;
    top: 50%;
    color: var(--c-white);
    opacity: 0;
  }

  .projects__name {
    font-size: var(--fs-project);
    line-height: 0.80;
    margin-bottom: 1rem;
    letter-spacing: -0.01em;
    display: inline-block;
    width: calc(100% - 4rem);
    color: var(--c-grey-dark);
    transition: padding-left 1.5s var(--ease-out-expo);
  }

  .projects__meta {
    margin-top: 0.5rem;
    font-size: 18px !important;
    margin-left: 0;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.5s ease 0.1s, transform 0.5s var(--ease-out-expo) 0.1s, margin-left 1.5s var(--ease-out-expo);
  }

  .projects__item.is-active .projects__name {
    padding-left: calc(70px + 1.4rem);
  }

  .projects__item.is-active .projects__meta {
    margin-left: calc(70px + 1.4rem);
    opacity: 1;
    transform: translateY(0);
  }

  /* --- sticky centered preview --- */
  .projects__stage {
    height: 100%;
  }

  .projects__sticky {
    position: sticky;
    top: calc(50svh - 13vw);
  }

  .projects__card {
    aspect-ratio: 16 / 10;
    border-radius: 10px;
    overflow: hidden;
    transform: rotate(-7deg);
    box-shadow: 0 40px 90px rgba(0, 0, 0, 0.55);
    will-change: transform;
  }

  @media (max-width: 900px) {
    .projects__wrap {
      grid-template-columns: 1fr;
    }
    .projects__stage {
      display: none;
    }
    .projects__item {
      padding-block: 1.6rem;
    }
    .projects__name {
      color: var(--c-white);
    }
    .projects__meta {
      opacity: 1;
      transform: none;
    }
    .projects__arrow {
      display: none;
    }
  }
</style>

<script>
  import { onReady, gsap } from '../scripts/app';

  onReady(() => {
    const wrap = document.querySelector<HTMLElement>('.projects__wrap');
    const items = gsap.utils.toArray<HTMLElement>('.projects__item');
    const card = document.querySelector<HTMLElement>('.projects__card');
    const img = card?.querySelector('img');
    if (!wrap || !items.length || !card || !img) return;

    let active = 0;

    // initialise first item arrow & colour
    {
      const a = items[active]?.querySelector<SVGSVGElement>('.projects__arrow');
      const n = items[active]?.querySelector<HTMLElement>('.projects__name');
      if (a) gsap.set(a, { opacity: 1, x: 0, yPercent: -50 });
      if (n) gsap.set(n, { color: '#f2f0ec' });
    }

    function setActive(index: number) {
      if (index === active) return;

      const prev = active;
      active = index;

      // deactivate previous
      const prevEl = items[prev];
      {
        const a = prevEl.querySelector<SVGSVGElement>('.projects__arrow');
        const n = prevEl.querySelector<HTMLElement>('.projects__name');
        if (a) gsap.to(a, { opacity: 0, x: -24, yPercent: -50, duration: 0.4, ease: 'expo.out', overwrite: 'auto' });
        if (n) gsap.to(n, { color: '#3a3a38', duration: 0.5, ease: 'expo.out', overwrite: 'auto' });
      }

      // activate new
      const nextEl = items[index];
      {
        const a = nextEl.querySelector<SVGSVGElement>('.projects__arrow');
        const n = nextEl.querySelector<HTMLElement>('.projects__name');
        if (a) gsap.to(a, { opacity: 1, x: 0, yPercent: -50, duration: 1.5, ease: 'expo.out', overwrite: 'auto' });
        if (n) gsap.to(n, { color: '#f2f0ec', duration: 1.5, ease: 'expo.out', overwrite: 'auto' });
      }

      items.forEach((el, i) => el.classList.toggle('is-active', i === index));

      const src = nextEl.dataset.preview;
      if (src) img!.src = src;

      gsap.to(card, {
        rotation: parseFloat(nextEl.dataset.tilt ?? '0'),
        duration: 2,
        ease: 'expo.out',
        overwrite: true,
      });
    }

    // the whole row — full width, image area included — reacts to hover:
    // whichever item's vertical band contains the pointer becomes active.
    // The pointer position is remembered and re-checked on scroll, so rows
    // sliding under a *still* cursor also trigger the change.
    let pointerY = -1;

    function hitTest() {
      if (pointerY < 0) return;
      for (let i = 0; i < items.length; i++) {
        const r = items[i].getBoundingClientRect();
        if (pointerY >= r.top && pointerY <= r.bottom) {
          setActive(i);
          return;
        }
      }
    }

    window.addEventListener(
      'pointermove',
      (e) => {
        pointerY = e.clientY;
        hitTest();
      },
      { passive: true }
    );

    window.addEventListener('scroll', hitTest, { passive: true });

    items.forEach((el, i) => {
      el.addEventListener('focusin', () => setActive(i));
    });
  });
</script>

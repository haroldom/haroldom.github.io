---
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section class="statement section" id="about">
  <div class="container">
    <p class="statement__text" data-split="words">
      {
        lang === 'en' ? (
          <>
            More than building <em class="serif-italic">websites.</em> I create{' '}
            <span class="chip-box" aria-hidden="true">
              <span class="statement__chip ph-media">
                <video src="/videos/about.mp4" autoplay muted loop playsinline></video>
              </span>
            </span>{' '}
            digital experiences that are <em class="serif-italic">visually refined,</em>{' '}
            technically solid, and designed to grow with your
            business
          </>
        ) : (
          <>
            Más que construir <em class="serif-italic">sitios web.</em> Creo{' '}
            <span class="chip-box" aria-hidden="true">
              <span class="statement__chip ph-media">
                <video src="/videos/about.mp4" autoplay muted loop playsinline></video>
              </span>
            </span>{' '}
            experiencias digitales <em class="serif-italic">visualmente refinadas,</em>{' '}
            técnicamente sólidas y diseñadas para crecer con tu
            negocio
          </>
        )
      }
    </p>
  </div>
</section>

<style>
  .statement {
    display: grid;
    place-items: center;
    min-height: 90svh;
    background: var(--c-black);
  }

  .statement__text {
    max-width: 24ch;
    margin-inline: auto;
    font-size: var(--fs-statement);
    line-height: 1.28;
    font-weight: 450;
    letter-spacing: -0.01em;
    text-align: center;
    text-wrap: balance;
  }

  .statement__text em {
    font-weight: 300;
  }

  .chip-box {
    display: inline-block;
    width: 2.6em;
    height: 1.05em;
    border-radius: 100px;
    vertical-align: -0.14em;
    margin-inline: 0.15em;
    overflow: hidden;
  }

  .statement__chip {
    display: block;
    width: 100%;
    height: 100%;
    will-change: clip-path;
  }

  .statement__chip img,
  .statement__chip video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>

  <script>
  import { onReady, gsap, reducedMotion } from '../scripts/app';

  onReady(() => {
    if (reducedMotion) return;

    const chip = document.querySelector<HTMLElement>('.statement__chip');
    if (!chip) return;

    const video = chip.querySelector<HTMLVideoElement>('video');

    gsap.set(chip, { clipPath: 'inset(0 100% 0 0)' });

    gsap.to(chip, {
      clipPath: 'inset(0 0% 0 0)',
      duration: 1,
      ease: 'expo.inOut',
      scrollTrigger: {
        trigger: chip,
        start: 'top 85%',
        once: true,
      },
    });

    if (video) {
      const section = document.querySelector<HTMLElement>('.statement');
      if (section) {
        new IntersectionObserver(
          (entries) => {
            const visible = entries[0].isIntersecting;
            visible ? video.play().catch(() => {}) : video.pause();
          },
          { threshold: 0.15 },
        ).observe(section);
      }
    }
  });
</script>

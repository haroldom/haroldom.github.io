---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<!-- monumental type transition: the word fills the viewport edge to edge
     (same treatment as the hero name), a work card floats behind it, and
     the camera dives through the full stop into the black of Services -->
<section class="curtain">
  <div class="curtain__sticky">
    <div class="curtain__card ph-media" aria-hidden="true">
      <img src="/images/project5.webp" alt="" width="1600" height="900" loading="lazy" />
    </div>

    <svg
      class="curtain__svg"
      viewBox="0 0 1440 720"
      preserveAspectRatio="xMidYMid slice"
      aria-hidden="true"
    >
      <g class="curtain__word-g">
        <text class="curtain__text" x="700" y="460" text-anchor="middle">
          {t('curtain.word')}
        </text>
        <circle class="curtain__dot" cx="0" cy="0" r="18"></circle>
      </g>
    </svg>

    <p class="curtain__sr">{t('curtain.word')}</p>
  </div>
</section>

<style>
  .curtain {
    /* runway = scroll distance driving the dive */
    height: 260vh;
    background: var(--c-paper);
    position: relative;
  }

  .curtain__sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: clip;
    background: var(--c-paper);
  }

  /* work card floating behind the type — the projects motif */
  .curtain__card {
    position: absolute;
    right: 10%;
    top: 16%;
    width: min(26vw, 400px);
    aspect-ratio: 16 / 10;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.3);
    z-index: 0;
    will-change: transform;
  }

  .curtain__card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .curtain__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .curtain__text {
    font-family: var(--f-serif);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.02em;
    fill: var(--c-black);
    font-size: 300px; /* resized at runtime to span the full width */
  }

  .curtain__dot {
    fill: var(--c-black);
  }

  .curtain__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  /* with reduced motion the beat adds nothing — skip it entirely */
  @media (prefers-reduced-motion: reduce) {
    .curtain {
      display: none;
    }
  }
</style>

<script>
  import { onReady, gsap, reducedMotion } from '../scripts/app';

  onReady(() => {
    if (reducedMotion) return;

    const section = document.querySelector<HTMLElement>('.curtain');
    const svg = document.querySelector<SVGSVGElement>('.curtain__svg');
    const wordG = document.querySelector<SVGGElement>('.curtain__word-g');
    const text = document.querySelector<SVGTextElement>('.curtain__text');
    const dot = document.querySelector<SVGCircleElement>('.curtain__dot');
    const card = document.querySelector<HTMLElement>('.curtain__card');
    if (!section || !svg || !wordG || !text || !dot || !card) return;

    /* size the word so word + full stop span the viewBox edge to edge
       (fonts are loaded here, so measurements are exact) */
    const r = 18;
    const dotAdvance = 30 + r * 2; // gap + dot width
    const probe = text.getBBox();
    const fs = Math.min(440, (300 * (1420 - dotAdvance)) / probe.width);
    text.setAttribute('font-size', String(fs));
    text.setAttribute('x', String(720 - dotAdvance / 2));
    text.setAttribute('y', String(360 + fs * 0.33));

    const bbox = text.getBBox();
    const cx = bbox.x + bbox.width + 30 + r;
    const cy = 360 + fs * 0.33 - r;
    dot.setAttribute('cx', String(cx));
    dot.setAttribute('cy', String(cy));

    // final window: fully inside the full stop
    const finalView = `${cx - 12} ${cy - 12} 24 24`;

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: 'top top',
        end: 'bottom bottom',
        scrub: true,
      },
    });

    /* the word settles into place */
    tl.fromTo(
      wordG,
      { y: 44, transformOrigin: '50% 50%' },
      { y: 0, duration: 0.12, ease: 'power2.out' },
      0
    );

    /* the work card drifts slowly behind the type (depth) and tilts */
    tl.fromTo(
      card,
      { rotation: -9, y: 30 },
      { rotation: -4, y: -60, duration: 0.7, ease: 'none' },
      0
    );

    /* accelerating vector dive through the full stop — the ink swallows
       the screen and lands on the black of the next section */
    tl.fromTo(
      svg,
      { attr: { viewBox: '0 0 1440 720' } },
      { attr: { viewBox: finalView }, duration: 0.83, ease: 'power2.in' },
      0.12
    );

    /* short hold on black before the release into Services */
    tl.to({}, { duration: 0.05 }, 0.95);
  });
</script>

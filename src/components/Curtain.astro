---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<!-- monumental type transition: the word fills the viewport edge to edge,
     dead-centered, and the camera dives through the full stop into black -->
<section class="curtain">
  <div class="curtain__sticky">
    <svg
      class="curtain__svg"
      viewBox="0 0 1440 720"
      preserveAspectRatio="xMidYMid slice"
      aria-hidden="true"
    >
      <g class="curtain__word-g">
        <text class="curtain__text" x="700" y="460" text-anchor="middle">
          {t('curtain.word')}
        </text>
        <circle class="curtain__dot" cx="0" cy="0" r="18"></circle>
      </g>
    </svg>

    <p class="curtain__sr">{t('curtain.word')}</p>
  </div>
</section>

<style>
  .curtain {
    /* runway = scroll distance driving the dive */
    height: 260vh;
    background: var(--c-paper);
    position: relative;
  }

  .curtain__sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: clip;
    background: var(--c-paper);
  }

  .curtain__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .curtain__text {
    font-family: var(--f-serif);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.02em;
    fill: var(--c-black);
    font-size: 300px; /* resized at runtime to span the full width */
  }

  .curtain__dot {
    fill: var(--c-black);
  }

  .curtain__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  @media (max-width: 720px) {
    .curtain {
      height: 360vh;
    }
    .curtain__svg {
      height: 110%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .curtain {
      display: none;
    }
  }
</style>

<script>
  import { onReady, gsap, reducedMotion } from '../scripts/app';

  onReady(() => {
    if (reducedMotion) return;

    const section = document.querySelector<HTMLElement>('.curtain');
    const sticky = document.querySelector<HTMLElement>('.curtain__sticky');
    const svg = document.querySelector<SVGSVGElement>('.curtain__svg');
    const wordG = document.querySelector<SVGGElement>('.curtain__word-g');
    const text = document.querySelector<SVGTextElement>('.curtain__text');
    const dot = document.querySelector<SVGCircleElement>('.curtain__dot');
    if (!section || !sticky || !svg || !wordG || !text || !dot) return;

    /* match the viewBox to the real viewport aspect so the word can be
       measured edge-to-edge and dead-centered vertically */
    const W = 1440;
    const H = Math.round((W * sticky.clientHeight) / sticky.clientWidth);
    svg.setAttribute('viewBox', `0 0 ${W} ${H}`);

    /* size the word so word + full stop span the width edge to edge
       (fonts are loaded here, so measurements are exact) */
    const r = 18;
    const dotAdvance = 30 + r * 2; // gap + dot width
    const probe = text.getBBox();
    const fs = (300 * (W - 24 - dotAdvance)) / probe.width;
    text.setAttribute('font-size', String(fs));
    text.setAttribute('x', String(W / 2 - dotAdvance / 2));
    text.setAttribute('y', '0');

    const bbox = text.getBBox();
    const centerOff = bbox.y + bbox.height / 2;
    const y = H / 2 - centerOff;
    text.setAttribute('y', String(y));

    const cx = bbox.x + bbox.width + 30 + r;
    const cy = y - r;
    dot.setAttribute('cx', String(cx));
    dot.setAttribute('cy', String(cy));

    // final window: fully inside the full stop
    const finalView = `${cx - 12} ${cy - 12} 24 24`;

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: 'top top',
        end: 'bottom bottom',
        scrub: true,
      },
    });

    /* the word settles into place */
    tl.fromTo(
      wordG,
      { y: 44, transformOrigin: '50% 50%' },
      { y: 0, duration: 0.1, ease: 'power2.out' },
      0
    );

    /* accelerating vector dive through the full stop — the ink swallows
       the screen and lands on black */
    tl.fromTo(
      svg,
      { attr: { viewBox: `0 0 ${W} ${H}` } },
      { attr: { viewBox: finalView }, duration: 0.85, ease: 'power2.in' },
      0.1
    );

    /* short hold on black before the reveal that follows */
    tl.to({}, { duration: 0.05 }, 0.95);
  });
</script>
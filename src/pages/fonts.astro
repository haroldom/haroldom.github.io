---
// Página temporal de comparación tipográfica — visita /fonts
// Bórrala cuando elijas (y avísame cuál quedó).
const fonts = [
  {
    name: 'Gambetta',
    files: ['Gambetta-Light', 'Gambetta-LightItalic', 'Gambetta-Regular', 'Gambetta-Italic'],
    note: 'Itálicas caligráficas afiladas — la alternativa libre más cercana a PP Editorial New (la serif nº1 en awwwards).',
  },
  {
    name: 'Boska',
    files: ['Boska-Light', 'Boska-LightItalic', 'Boska-Regular', 'Boska-Italic'],
    note: 'Alto contraste, vibra fashion/editorial — la más dramática de las cuatro.',
  },
  {
    name: 'Erode',
    files: ['Erode-Light', 'Erode-LightItalic', 'Erode-Regular', 'Erode-Italic'],
    note: 'Serif cálida con terminales suaves — elegante sin ser barroca.',
  },
  {
    name: 'Zodiak',
    files: [],
    note: 'La actual, para comparar.',
  },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Font lab — elige la display serif</title>
    <style is:global>
      @font-face { font-family: 'Gambetta'; src: url('/fonts/Gambetta-Light.woff2') format('woff2'); font-weight: 300; font-style: normal; }
      @font-face { font-family: 'Gambetta'; src: url('/fonts/Gambetta-LightItalic.woff2') format('woff2'); font-weight: 300; font-style: italic; }
      @font-face { font-family: 'Gambetta'; src: url('/fonts/Gambetta-Regular.woff2') format('woff2'); font-weight: 400; font-style: normal; }
      @font-face { font-family: 'Gambetta'; src: url('/fonts/Gambetta-Italic.woff2') format('woff2'); font-weight: 400; font-style: italic; }
      @font-face { font-family: 'Boska'; src: url('/fonts/Boska-Light.woff2') format('woff2'); font-weight: 300; font-style: normal; }
      @font-face { font-family: 'Boska'; src: url('/fonts/Boska-LightItalic.woff2') format('woff2'); font-weight: 300; font-style: italic; }
      @font-face { font-family: 'Boska'; src: url('/fonts/Boska-Regular.woff2') format('woff2'); font-weight: 400; font-style: normal; }
      @font-face { font-family: 'Boska'; src: url('/fonts/Boska-Italic.woff2') format('woff2'); font-weight: 400; font-style: italic; }
      @font-face { font-family: 'Erode'; src: url('/fonts/Erode-Light.woff2') format('woff2'); font-weight: 300; font-style: normal; }
      @font-face { font-family: 'Erode'; src: url('/fonts/Erode-LightItalic.woff2') format('woff2'); font-weight: 300; font-style: italic; }
      @font-face { font-family: 'Erode'; src: url('/fonts/Erode-Regular.woff2') format('woff2'); font-weight: 400; font-style: normal; }
      @font-face { font-family: 'Erode'; src: url('/fonts/Erode-Italic.woff2') format('woff2'); font-weight: 400; font-style: italic; }
      @font-face { font-family: 'Zodiak'; src: url('/fonts/Zodiak-Light.woff2') format('woff2'); font-weight: 300; font-style: normal; }
      @font-face { font-family: 'Zodiak'; src: url('/fonts/Zodiak-LightItalic.woff2') format('woff2'); font-weight: 300; font-style: italic; }
      @font-face { font-family: 'Satoshi'; src: url('/fonts/Satoshi-Regular.woff2') format('woff2'); font-weight: 400; }

      * { margin: 0; box-sizing: border-box; }
      body { font-family: 'Satoshi', sans-serif; background: #f2f0ec; color: #0c0c0c; }
      .intro { padding: 3rem 4vw 1rem; }
      .intro h1 { font-size: 1.2rem; }
      .intro p { color: #777; font-size: 0.9rem; margin-top: 0.4rem; }
      .card { border-top: 1px solid rgba(0,0,0,0.15); padding: 3rem 4vw 4rem; }
      .card--dark { background: #0c0c0c; color: #f2f0ec; }
      .label { font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: #999; }
      .note { font-size: 0.85rem; color: #888; max-width: 46ch; margin-top: 0.3rem; }
      .word { font-weight: 300; font-style: italic; font-size: clamp(4rem, 12vw, 11rem); line-height: 1.05; margin-top: 1.5rem; }
      .name { font-weight: 400; font-size: clamp(3rem, 9vw, 8rem); text-transform: uppercase; line-height: 1; letter-spacing: -0.01em; margin-top: 1rem; white-space: nowrap; overflow: hidden; }
      .mix { font-size: clamp(1.6rem, 4vw, 3.2rem); margin-top: 1.2rem; font-weight: 300; }
      .mix em { font-style: italic; }
    </style>
  </head>
  <body>
    <div class="intro">
      <h1>Font lab — display serif</h1>
      <p>
        Cada bloque muestra la misma composición: la palabra de la transición, tu nombre del
        hero y un heading mixto. Arriba en claro, abajo en oscuro. Dime cuál gana.
      </p>
    </div>

    {
      fonts.map((f) => (
        <>
          <section class="card" style={`--f: '${f.name}'`}>
            <p class="label">{f.name}</p>
            <p class="note">{f.note}</p>
            <p class="word" style={`font-family: '${f.name}'`}>Services.</p>
            <p class="name" style={`font-family: '${f.name}'`}>Harold Ormeño</p>
            <p class="mix" style={`font-family: '${f.name}'`}>
              From concept <em>to launch.</em>
            </p>
          </section>
          <section class="card card--dark">
            <p class="word" style={`font-family: '${f.name}'`}>Services.</p>
            <p class="name" style={`font-family: '${f.name}'`}>Harold Ormeño</p>
          </section>
        </>
      ))
    }
  </body>
</html>
